# Backend service environment variables (do NOT commit real secrets)
# Copy this file to .env.local for local dev, and set the same keys in your Railway service.

# DeepSeek API secret (set in Railway UI, never in frontend)
DEEPSEEK_API_KEY=

# Required in production for signed login tokens. Use a random value with at least 32 characters.
AUTH_SECRET=

# Optional: restrict CORS to your Netlify domain (e.g. https://career-future.netlify.app)
ALLOWED_ORIGIN=

# Optional for local dev only; Railway provides PORT automatically
PORT=3001
